DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NODE_ENV="development"
PORT=3000

# App
NODE_ENV="development"
PORT=3000

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))
AUDIT_HMAC_SECRET=your_long_random_secret_here

# Telegram
# Create a bot via @BotFather to get a token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Public URL of this app where Telegram delivers updates, e.g. https://api.yourdomain.com/ingest/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Required: echoed back in the x-telegram-bot-api-secret-token header.
# The webhook will reject (401) updates without a matching constant-time-equal secret.
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret


JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend SPA origin that receives the OAuth redirect-back token post
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated allow-list of browser origins permitted by CORS
# e.g. CORS_ORIGINS="https://ajoguard.vercel.app,https://staging.ajoguard.vercel.app"
CORS_ORIGINS=

# Expose the Swagger UI at /api (defaults to on outside production).
# Set to "true" to force it on in production too.
SWAGGER_ENABLED=false

